{
  "redirects": [
    {
      "source": "/tools/realestate-com-au",
      "destination": "/tools/zillow",
      "statusCode": 301
    },
    {
      "source": "/tools/realestate-com-au/:path*",
      "destination": "/tools/zillow",
      "statusCode": 301
    },
    {
      "source": "/blog/using-realestate-com-au-photos-to-spot-condition-red-flags",
      "destination": "/blog/using-zillow-photos-to-spot-condition-red-flags",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/api/sitemap", "destination": "/api/sitemap" },
    { "source": "/api/share", "destination": "/api/share" },
    { "source": "/api/blog-list", "destination": "/api/blog-list" },
    { "source": "/api/article", "destination": "/api/article" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/sitemap-articles.xml", "destination": "/api/sitemap" },
    { "source": "/rss.xml", "destination": "/api/rss" },
    { "source": "/share/:slug", "destination": "/api/share?slug=:slug" },
    { "source": "/blog/category/:slug", "destination": "/api/blog-list?category=:slug" },
    { "source": "/blog/:slug", "destination": "/api/article?slug=:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
